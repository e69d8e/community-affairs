# 复制为 .env 并填入实际值（.env 已被 gitignore，不会入库）：cp .env.example .env
# ⚠️ 建议密码为 16 位以上字母数字组合；勿含空格、$、引号等特殊字符（会破坏 compose 命令解析）
# ⚠️ MySQL 密码仅在数据卷首次初始化时写入：首次启动后修改需重建数据卷（会清空数据），详见 README FAQ

# MySQL（容器编排与后端连接共用）
MYSQL_PASSWORD=your_mysql_password

# Redis
REDIS_PASSWORD=your_redis_password

# MinIO 对象存储
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=your_minio_secret_key

# 浏览器访问上传文件的公开地址（拼接入库的文件 URL）
# 本地单机保持默认即可；跨机/服务器部署请改为 http://<服务器IP>:9000，否则其他设备图片显示破图
MINIO_PUBLIC_ENDPOINT=http://127.0.0.1:9000

# JWT 密钥：openssl rand -base64 48 生成，各部署必须不同（未设置时后端启动即失败）
JWT_SECRET=your_jwt_secret_at_least_32_bytes

# AI 大模型服务配置 (基于 LangChain4j Chat Completions，兼容 DeepSeek / 通义千问 / 本地 Ollama 等；留空自动使用离线 Mock 降级器)
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL_NAME=deepseek-chat

